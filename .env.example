# Server-side only. Used by src/data/smugmug.ts (OAuth 1.0a, HMAC-SHA1) and
# scripts/smugmug.ts (`pnpm smugmug albums|images|sizes|raw`). The token pair
# is permanent once obtained via the OAuth handshake — no repeated login.
SMUGMUG_API_KEY=smugmug_api_key
SMUGMUG_API_SECRET=smugmug_apis_ecret
SMUGMUG_OAUTH_TOKEN=smugmug_ouauth_token
SMUGMUG_OAUTH_TOKEN_SECRET=smugmug_oauth_token_seret