  "narrative": {
    "northStar": "The Night Studio",
    "overview": "A dark, green-tinted workspace where the work is the lit object. Surfaces are near-black forest tones separated by hairlines, not shadows; a single mint accent marks what is live, active or clickable. The light theme is the same studio with the lights on.",
    "keyCharacteristics": [
      "One accent (mint), used for state and action, never as a surface wash.",
      "Hairline borders and tonal steps instead of shadows at rest.",
      "Mono uppercase labels; grotesk display with negative tracking.",
      "Quietly tactile: 1–3px lifts, fades, an accent underline that grows.",
      "Dark and light themes are co-equal; every token has a pair."
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Mint appears only on state and action: fills, hovers, active markers, the accent word in a headline. It never floods a surface.", "section": "colors" },
      { "name": "The Twin Theme Rule", "body": "Every colour token has a dark and a light value. Never hard-code a hex in a view; use the variable.", "section": "colors" },
      { "name": "The Mono Controls Rule", "body": "Buttons, tags, lang toggle and eyebrows are mono. Prose and headlines are never mono.", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "No shadow at rest. If something needs to feel raised, step the surface tone first.", "section": "elevation" }
    ],
    "dos": [
      "Do use the CSS variables from src/styles/globals.scss; build both themes.",
      "Do keep mint for state and action only.",
      "Do put labels, buttons and tags in JetBrains Mono.",
      "Do respect prefers-reduced-motion on every new transition or animation.",
      "Do keep hover lifts to 1–3px and 0.15–0.2s."
    ],
    "donts": [
